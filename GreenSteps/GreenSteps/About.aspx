<%@ Page Title="About" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="About.aspx.cs" Inherits="GreenSteps.About" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">

<div class="about-container">

    <div class="about-hero">
        <h1>🌱 About GreenSteps</h1>
        <p class="tagline">Empowering everyone to take small, meaningful steps toward a greener planet</p>
    </div>

    <div class="about-section">
        <h2>🌍 Who We Are</h2>
        <p>
            <strong>GreenSteps</strong> is a sustainable living learning platform designed for anyone
            who wants to make a positive impact on the environment. Whether you're just starting your
            eco-journey or you're already a sustainability enthusiast, our platform offers something
            for everyone.
        </p>
        <p>
            We believe that <strong>small actions, taken consistently, lead to big changes</strong>.
            Through engaging articles, expert-led videos, and interactive quizzes, we help learners
            build the knowledge and habits needed for a sustainable lifestyle.
        </p>
    </div>

    <div class="mission-box">
        <h3>🎯 Our Mission</h3>
        <p>
            "To make sustainable living knowledge accessible to everyone through engaging,
            interactive digital learning resources — one green step at a time."
        </p>
    </div>

    <div class="about-section">
        <h2>📚 What We Offer</h2>
        <ul>
            <li><strong>Articles</strong> — In-depth guides on sustainable habits and eco-friendly tips</li>
            <li><strong>Videos</strong> — Expert-led lessons on renewable energy and green tech</li>
            <li><strong>Quizzes</strong> — Interactive challenges that test and reinforce your learning</li>
            <li><strong>Personal Account</strong> — Register to take quizzes and track your eco-journey</li>
        </ul>
    </div>

    <div class="about-section">
        <h2>👨‍💻 About This Project</h2>
        <p>
            GreenSteps was built as part of the <strong>CT050-3-2-WAPP — Web Applications</strong>
            group assignment at <strong>Asia Pacific University of Technology and Innovation (APU)</strong>.
        </p>
        <p>
            🛠️ <strong>Tech Stack:</strong> ASP.NET Web Forms • C# • SQL Server • HTML5 • CSS3
        </p>
    </div>

</div>

</asp:Content>
